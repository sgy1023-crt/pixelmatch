// Generated by tools/generate_ssim_reference.py; do not edit by hand.
// SciPy float64 full maps; independent weighted-central-moment components.
// Every boundary pixel is checked, not only the cropped score.

///|
fn ssim_reference_image(
  width : Int32,
  height : Int32,
  rgba : Array[Int32],
) -> @pixelmatch.Image {
  let image = @pixelmatch.Image::new(width, height)
  for i in 0..<rgba.length() {
    image.data[i] = rgba[i]
  }
  image
}

